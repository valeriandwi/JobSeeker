# JobSeeker — environment configuration template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.

# --- runtime ---
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=debug

# --- database ---
# Local dev cluster created by `make dev-db-init` (Postgres 15, port 5433, trust auth, localhost only).
DATABASE_URL=postgres://jobseeker@127.0.0.1:5433/jobseeker_dev?sslmode=disable

# --- auth ---
# Generate with: openssl rand -hex 32
SESSION_COOKIE_NAME=js_session
SESSION_TTL_HOURS=720
COOKIE_SECURE=false

# --- uploads / storage ---
# Private directory for uploaded CVs. Must NOT be inside any static/public root.
DATA_DIR=./data
MAX_UPLOAD_BYTES=10485760

# --- scheduler ---
SCHEDULER_ENABLED=true
DEFAULT_SCHEDULE_CRON=0 8 * * *
DEFAULT_SCHEDULE_TIMEZONE=Asia/Jakarta
SCHEDULER_POLL_INTERVAL=30s
SCHEDULER_ADVISORY_LOCK_TIMEOUT=5m

# --- rate limiting (requests per minute) ---
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=30

# --- source credentials (optional; operator-level, never per-user) ---
# Adzuna: https://developer.adzuna.com/  (free tier: 25/min, 250/day, 1000/week, 2500/month)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# USAJOBS: https://developer.usajobs.gov/apirequest/  (requires a contact email in User-Agent)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
# Jooble: partner key, per country domain (https://jooble.org/api/about)
JOOBLE_API_KEY=

# --- outbound HTTP to sources ---
SOURCE_HTTP_TIMEOUT=20s
SOURCE_MAX_ATTEMPTS=3
SOURCE_BACKOFF_BASE=500ms

# --- frontend (Vite dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
