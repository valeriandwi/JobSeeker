# Frontend configuration. Copy to `.env` only if you need to override something.

# API base URL.
#
# Leave this EMPTY (or unset) for both development and production:
#   - `pnpm dev` serves the SPA on http://localhost:5173 and proxies /api to the
#     backend (override the target with VITE_API_PROXY_TARGET below),
#   - in production Caddy serves the SPA and proxies /api on the same origin.
# Same-origin keeps the session cookie first-party, which SameSite=Lax requires.
#
# Only set an absolute URL if the API really lives on another origin, and then it
# must be the SAME SITE as the page or the browser will accept the login cookie
# and then refuse to send it on later requests — which shows up as "logging in
# does nothing but bounce back to /login".
#   localhost:5173 -> http://localhost:8080   same-site    works
#   localhost:5173 -> http://127.0.0.1:8080   CROSS-site   does NOT work
#
# VITE_API_BASE_URL=http://localhost:8080

# Where `pnpm dev` proxies /api, /healthz and /readyz. Default: http://127.0.0.1:8080
# VITE_API_PROXY_TARGET=http://127.0.0.1:8080
